#include <bits/stdc++.h>
using namespace std;
class Student {
protected:
    string name;
    int age;
    int enrollno;
    double marks;
public:
    void setStudent(string name, int age, int enrollno, double marks) {
        this->name = name;
        this->age = age;
        this->enrollno = enrollno;
        this->marks = marks;
    }
    void display() {
        cout << "Student Details\n";
        cout << "name : " << name << endl;
        cout << "age : " << age << endl;
        cout << "enrollno : " << enrollno << endl;
        cout << "marks : " << marks << endl;
    }
};
class Faculty {
protected:
    string name;
    string facultycode;
    double salary;
    string dept;
    int age;
    int exp;
    string gender;

public:
    void setFaculty(string name, string facultycode, double salary,
    string dept, int age, int exp, string gender) {
        this->name = name;
        this->facultycode = facultycode;
        this->salary = salary;
        this->dept = dept;
        this->age = age;
        this->exp = exp;
        this->gender = gender;
    }
    void display() {
        cout << "Faculty Details\n";
        cout << "name : " << name <<endl;
        cout << "facultycode : " << facultycode <<endl;
        cout << "salary : " << salary <<endl;
        cout << "dept : " << dept <<endl;
        cout << "age : " << age <<endl;
        cout << "exp : " << exp <<endl;
        cout << "gender : " << gender <<endl;
    }
};
class Person : public Student, public Faculty {
public:
    void displayBoth() {
        Student::display();
        Faculty::display();}
};
int main() {
    Person p;
    p.setStudent("Ajay", 19, 67565, 45.45); //for user define input use getline while taking name
    p.setFaculty("  John"," 36E0",34545,"CSE",23,4,"male");
    
    p.displayBoth();
}
